{
  "name": "mirror-outfit-selector",
  "version": "0.1.0",
  "description": "Mirror — virtual try-on outfit selector widget POC. Embed on any clothing site with one script tag.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "generate:placeholders": "node scripts/generate-placeholders.js",
    "generate:products": "node scripts/generate-products.js",
    "generate:canned": "node scripts/generate-canned.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
